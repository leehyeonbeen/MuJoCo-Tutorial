<mujoco>
    <option gravity="0 0 -9.81"/>
    <worldbody>
        <light pos="0 0 3"/>
        <geom type="plane" size="2 2 0.1"/>
        <!-- This box WILL collide with floor (default contype=1, conaffinity=1) plane is on channel 1 (contype), reacts to channel 1 (conaffinity) --> 
        <body pos="-0.3 0 1">
            <joint type="free"/>
            <geom type="sphere" size=".1" rgba="1 0 0 1"/>
        </body>
        <!-- This box will NOT collide (contype=2 doesn't match floor's conaffinity=1) -->
        <body pos="0.3 0 1">
            <joint type="free"/>
            <geom type="sphere" size=".1" rgba="0 0 1 1" contype="2" conaffinity="2"/>
        </body>
    </worldbody>
</mujoco>