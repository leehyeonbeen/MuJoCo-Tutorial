<mujoco>
    <option gravity="0 0 -9.81"/>
    <worldbody>
        <light pos="0 0 3"/>
        <geom type="plane" size="1 1 .1" rgba=".9 .9 .9 1"/>
        
        <body name="master" pos="-.3 0 .5">
            <joint name="j_master" type="hinge" axis="0 1 0"/>
            <geom type="capsule" fromto="0 0 0 0 0 -.3" size=".025" rgba=".2 .7 .3 1"/>
        </body>

        <body name="follwer" pos=".3 0 .5">
            <joint name="j_follower" type="hinge" axis="0 1 0"/>
            <geom type="capsule" fromto="0 0 0 0 0 -.2" size=".02" rgba=".7 .3 .2 1"/>
        </body>
    </worldbody>

    <equality>
        <joint joint1="j_master" joint2="j_follower" polycoef="0 2 0 0 0"/>
    </equality>

    <actuator>
        <motor joint="j_master" ctrlrange="-5 5"/>
    </actuator>
</mujoco>